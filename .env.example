# Environment Variables — copy to .env and fill in values
# Never commit .env to version control

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Port the Go API listens on
PORT=8080

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (pgx DSN format)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce?sslmode=disable

# ─── Cache / Queue ───────────────────────────────────────────────────────────
# Redis connection URL (used for auth token state, rate limiting, job queue)
REDIS_URL=redis://localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────────
# Ed25519 private key for signing JWTs (PEM format, base64-encoded)
JWT_PRIVATE_KEY=

# Ed25519 public key for verifying JWTs (PEM format, base64-encoded)
JWT_PUBLIC_KEY=

# Access token lifetime in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_TTL=900

# Refresh token lifetime in seconds (default: 604800 = 7 days)
JWT_REFRESH_TOKEN_TTL=604800

# ─── Facebook OAuth ───────────────────────────────────────────────────────────
# Facebook App ID and secret for social login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Razorpay API credentials (https://razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret for signature verification
RAZORPAY_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# SMTP host — in local dev this points to MailHog; in production to SES SMTP
MAILHOG_HOST=localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ecommerce.local

# AWS SES credentials (production only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_ADDRESS=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated; no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Base URL of the backend API consumed by the Next.js API client
NEXT_PUBLIC_API_URL=http://localhost:8080
